{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iMini Tuner",
  "version": "2.2.0",
  "identifier": "com.imini.tuner",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "iMini Tuner",
        "width": 900,
        "height": 520,
        "minWidth": 900,
        "minHeight": 520,
        "maxWidth": 900,
        "maxHeight": 520,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
